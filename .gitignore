# ─── Secrets ──────────────────────────────────────────────────────────────────
# Never commit .env — it holds OPENAI_API_KEY and any other live credentials.
.env
.env.*
!.env.example

# ─── Python build artifacts ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
wheels/
*.egg-info/
*.egg
pip-wheel-metadata/

# ─── Virtual environments ─────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Test / lint / type-check caches ──────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.tox/

# ─── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ─── IDE / editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ─── OS ───────────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Docker ───────────────────────────────────────────────────────────────────
# Local compose overrides — keep docker-compose.yml itself committed.
docker-compose.override.yml
docker-compose.override.yaml
